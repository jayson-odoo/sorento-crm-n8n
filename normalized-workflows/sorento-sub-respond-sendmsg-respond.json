    {
      "parameters": {
        "jsCode": "const LIMIT = 1200;\n// change field if needed\nconst text = String($input.first().json.message).trim();\n\nif (!text) {\n  return [{ json: { message: '' } }];\n}\n\nif (text.length <= LIMIT) {\n  return [{ json: { message: text, part: 1, total_parts: 1 } }];\n}\n\n// try to split nicely before limit\nlet splitAt = text.lastIndexOf('\\n', LIMIT);\nif (splitAt < 800) {\n  splitAt = text.lastIndexOf(' ', LIMIT);\n}\nif (splitAt < 800) {\n  splitAt = LIMIT;\n}\n\nconst part1 = text.slice(0, splitAt).trim();\nconst part2 = text.slice(splitAt).trim();\n\nreturn [\n  { json: { message: part1, part: 1, total_parts: 2 } },\n  { json: { message: part2, part: 2, total_parts: 2 } },\n];"
      },
