      ],
      "id": "ead9564b-2055-4d1f-83e2-5e794f3adf91",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Input: items[0].json.tools = your array\nconst input = $input.all();\n\nconst map = {};\n\nfor (const entry of input) {\n  // get part after \"implemented::\"\n  const raw = entry.json.source_id || '';\n  const name = raw.split('::')[1] || raw;\n\n  if (!map[name]) {\n    map[name] = { name, similarity: 0 };\n  }\n  map[name].similarity += entry.json.similarity;\n}\n\nconst tools = Object.values(map);\n\n// Return as new item\nreturn [\n  {\n    json: {\n      tools,\n    },\n  },\n];"
      },
