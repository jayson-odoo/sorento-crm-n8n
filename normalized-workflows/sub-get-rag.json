        "postgres": {
          "id": "ETJL5KoaA1UpkDip",
          "name": "sorento-crm-db"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const embedding = $json.data[0].embedding;\n\nreturn [\n  {\n    json: {\n      vector_text: `[${embedding.join(',')}]`,\n      source_type: $('When Executed by Another Workflow').first().json.source_type,\n      limit: $('When Executed by Another Workflow').first().json.limit\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
