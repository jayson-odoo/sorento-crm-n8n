        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  id, \n  source_id, \n  source_type, \n  similarity\nFROM (\n  SELECT DISTINCT ON (source_id)\n    id,\n    source_id,\n    source_type,\n    1 - (embedding <=> $1::vector) AS similarity,\n    embedding <=> $1::vector AS distance\n  FROM embedding_chunks\n  WHERE source_type = $2 and is_current = true\n  ORDER BY source_id, embedding <=> $1::vector ASC\n) AS unique_chunks\nORDER BY distance ASC\nLIMIT $3;",
        "options": {
          "queryReplacement": "={{ $json.vector_text }},{{ $json.source_type }},{{ $json.limit }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
