    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function buildInsertFromConfig(configItem) {\n  const { insert_table, insert_data, incoming_data } = configItem;\n\n  // 1) Get the source object to insert from (e.g. incoming_data[\"packing_list\"])\n  const source = incoming_data[insert_data];\n  if (!source || typeof source !== 'object') {\n    throw new Error(`Source data '${insert_data}' not found in incoming_data`);\n  }\n\n  // 2) Build column list and value list from the source object's keys\n  const columns = [];\n  const values = [];\n\n  for (const [key, rawVal] of Object.entries(source)) {\n    columns.push(key);\n\n    // Basic SQL escaping for single quotes\n    let val = rawVal;\n    if (val === null || val === undefined) {\n      values.push('NULL');\n    } else if (typeof val === 'number') {\n      values.push(val.toString());\n    } else if (typeof val === 'boolean') {\n      values.push(val ? 'TRUE' : 'FALSE');\n    } else {\n      const escaped = String(val).replace(/'/g, \"''\");\n      values.push(`'${escaped}'`);\n    }\n  }\n\n  const columnsSql = columns.join(', ');\n  const valuesSql = values.join(', ');\n\n  const sql = `INSERT INTO ${insert_table} (${columnsSql}) VALUES (${valuesSql}) RETURNING ID;`;\n  return sql;\n}\nconst items = [ $json ];\n\nconst sql = buildInsertFromConfig(items[0]);\n// Example result:\n// INSERT INTO inbound_shipments (shipment_number, expected_arrival_date, shipment_date, shipping_container_number)\n// VALUES ('WHA2088594','45938','9/26/25','WHSU6960643');\n\nreturn {\n  \"output\": sql\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
