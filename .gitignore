# === Secrets (NEVER commit) ===
# .env = connection facts + creds
.env
.env.*
# .mcp.json holds a live n8n MCP Bearer JWT
.mcp.json
# GCP service-account key
teh-jayson-*.json
*-service-account*.json

# === Docker runtime volumes (bind-mounted state, huge, machine-local) ===
mongodb_data/
mongodb_config/
n8n_data/
postgres_data/
redis_data/

# === Large DB dumps / data (not source) ===
# ~729MB pg dump
sorento_embedding.sql
*.dump

# === Claude Code machine-local overrides ===
.claude/settings.local.json

# === OS / editor cruft ===
.DS_Store
*.swp

# --- secret hygiene (added 2026-07-21) ---
# Raw n8n workflow dumps embed literal x-api-key values in node parameters.
# Never commit them; keep them on disk for rollback only.
scratchpad/
n8n-workflows-init/tests/reviews/backups/**/*.json
*-before.json
*-after.json

# playwright/chrome MCP artifacts — Chrome is uninstalled; use `npx -y agent-browser` instead
.playwright-mcp/
test-results/
playwright-report/
